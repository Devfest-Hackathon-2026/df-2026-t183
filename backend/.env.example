GOOGLE_CLOUD_PROJECT=your-project-id
# ローカルのユーザー ADC で TTS を使う場合の割り当て先。Cloud Run での設定は任意。
GOOGLE_CLOUD_QUOTA_PROJECT=
GOOGLE_CLOUD_LOCATION=your-vertex-location
GEMINI_MODEL=your-available-model-id
GEMINI_MAX_OUTPUT_TOKENS=2048
# Speech-to-Text は SPEECH_MODEL を空欄にすると無効。設定時は Linux と ffmpeg / ffprobe が必要。
SPEECH_MODEL=chirp_2
SPEECH_LOCATION=asia-southeast1
ALLOWED_ORIGINS=http://localhost:5173
PORT=8080
# Phase 2 の保存は SESSION_KEYS_JSON と HISTORY_KEYS_JSON を両方設定すると有効。
FIRESTORE_DATABASE_ID='(default)'
HISTORY_TTL_DAYS=30
# Cloud Run では Secret Manager の固定バージョンを環境変数に注入する。
# JSON: {"activeKeyId":"key-id","keys":{"key-id":"<32バイト以上の乱数を標準Base64化>"}}
# 用途ごとに異なる鍵を使う。旧鍵も対象の署名・記録が失効するまで keys に残す。
SESSION_KEYS_JSON=
HISTORY_KEYS_JSON=
